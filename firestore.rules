rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.participants || chatId == 'global_chat');
      allow create: if request.auth != null
        && (request.auth.uid in request.resource.data.participants || chatId == 'global_chat');
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.participants || chatId == 'global_chat');
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || chatId == 'global_chat');
        allow create: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || chatId == 'global_chat');
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
