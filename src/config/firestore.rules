rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Profile (username, photoURL, pushToken) is owned by the user.
      // Displayed names/avatars elsewhere resolve live from here.
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
            || request.auth.uid in resource.data.participants
            || chatId == 'global_chat');
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participants || chatId == 'global_chat');
      allow update: if isSignedIn()
        && (chatId == 'global_chat' || (
          request.auth.uid in resource.data.participants && (
            // Ordinary message + read-receipt flow touches only these keys.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'updatedAt', 'participantMeta'])
            // Group admins (or anyone when no admins remain) may manage the group.
            || request.auth.uid in resource.data.get('groupAdmins', [])
            || resource.data.get('groupAdmins', []).size() == 0
            // Anyone may remove only themselves (leave group).
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'groupAdmins', 'updatedAt'])
              && resource.data.participants.toSet().difference(request.resource.data.participants.toSet()) == [request.auth.uid].toSet()
              && request.resource.data.get('groupAdmins', []).toSet().difference(resource.data.get('groupAdmins', []).toSet()).size() == 0
            )
          )
        ));
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || chatId == 'global_chat');
        allow create: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || chatId == 'global_chat');
        // Message text is owned by the sender; anyone may toggle reactions.
        allow update: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || chatId == 'global_chat')
          && (
            resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
